# Пример .env для деплоя (скопируйте в корень проекта как .env)
# cp deploy/.env.production.example .env

# Обязательно
BOT_TOKEN=your_bot_token_from_botfather
ADMINS=123456789,987654321
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_strong_password
POSTGRES_DB=dating

# Опционально
BROADCAST_LIMIT=1000
# Домен: укажите в обоих переменных (бот + CORS для API)
MINI_APP_URL=https://yourdomain.com
ADDITIONAL_CORS_ORIGINS=https://yourdomain.com
FRONTEND_PORT=80
ALLOW_DEV_USER_ID=0
VITE_API_URL=
