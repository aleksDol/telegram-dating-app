BOT_TOKEN=your_bot_token_here
ADMINS=your_admin_id_here
BROADCAST_LIMIT=1000

# Веб-админка (логин, пароль и токен для входа на /admin)
LOGIN_ADMIN=admin
PASSWORD_ADMIN=123
TOKEN_ADMIN=1234567

# PostgreSQL (обязательно для бэкенда)
DATABASE_URL=postgresql://user:password@localhost:5432/dating

# URL Mini App (для кнопки «Открыть приложение» при /start). Один формат: https://ваш-домен.ru
# MINI_APP_URL=https://spontime.ru

# REST API для Mini App (localhost)
# ALLOW_DEV_USER_ID=1   # разрешить заголовок X-Dev-User-Id для проверки без Telegram
