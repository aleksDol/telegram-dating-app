# URL бэкенд API. Для localhost: запустите API (uvicorn api:app --port 8000) и укажите:
VITE_API_URL=http://localhost:8000

# Имя бота для реферальных ссылок (без @)
# VITE_BOT_USERNAME=Spontime_bot

# Для проверки на localhost без Telegram: ID пользователя в заголовке X-Dev-User-Id (бэкенд должен быть с ALLOW_DEV_USER_ID=1)
# VITE_DEV_USER_ID=1
